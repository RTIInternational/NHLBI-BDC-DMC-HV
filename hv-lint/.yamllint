---
# yamllint configuration for BDC DMC Harmonization
# Used by YAML-LinkML Expert agent to lint HV repo transformation specs
#
# Usage:
#   yamllint -c hv-lint/.yamllint <path-to-yaml-files>
#   python hv-lint/phase-1/run_yamllint.py [--cohort <name>] [--format parsable]
#
# Exceptions per team decision (2026-03-14):
#   - line-length: disabled (long expr strings are normal)
#   - trailing-spaces: disabled (not a functional concern)
#   - new-line-at-end-of-file: disabled (not a functional concern)
#   - new-lines: disabled (Windows CRLF is normal in this environment)
#   - document-start: disabled (files don't use --- consistently)
#   - comments-indentation: disabled (#885) -- every hit was a commented-out YAML line kept by
#     the repo convention; none affects parsing or output (664 on main 731984f5)

extends: default

rules:
  # --- Disabled rules ---
  line-length: disable
  trailing-spaces: disable
  new-line-at-end-of-file: disable
  new-lines: disable
  document-start: disable
  comments-indentation: disable

  # --- Enabled rules ---
  indentation:
    spaces: 2
    indent-sequences: whatever
    check-multi-line-strings: false

  key-duplicates:
    level: error

  # error, not warning: yamllint exits 0 on warnings and run_yamllint.py does not pass them to
  # the known-issue step, so a warning is neither fatal nor ratcheted. A bare Yes:/No:/on: key
  # parses as a bool, which linkml-map never matches (rule 1.15).
  truthy:
    level: error
    allowed-values: ['true', 'false']
    check-keys: true

  comments:
    require-starting-space: true
    ignore-shebangs: true
    min-spaces-from-content: 1

  empty-lines:
    max: 2
    max-start: 0
    max-end: 1

  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 0

  colons:
    max-spaces-before: 0
    max-spaces-after: 1

  commas:
    max-spaces-before: 0
    min-spaces-after: 1
    max-spaces-after: 1

  hyphens:
    max-spaces-after: 1
