replace `x'="[tbs_us]" if inlist(`x',"tbs","1tbs")                                                                                                                                                   
replace `x'="a" if inlist(`x',"yearsold","years","year","numberofyearssinceexam1")                                                                                                                   
replace `x'="agatstonunit" if inlist(`x',"Agatston unit")                                                                                                                                            
replace `x'="cm" if inlist(`x',"centimeters")                                                                                                                                                        
replace `x'="cs" if inlist(`x',"hundredthsofsecond","hundredthsofasecond","hundredthsofasec.","hundredsofsecond")                                                                                    
replace `x'="d" if inlist(`x',"days","dayssinceexam1","numberofdayssinceexam1")                                                                                                                      
replace `x'="dL" if inlist(`x',"dl","deciliter")                                                                                                                                                     
replace `x'="dg/dL" if inlist(`x',"dg/dl","decigrams/100ml")                                                                                                                                         
replace `x'="dm" if inlist(`x',"cmx10")                                                                                                                                                              
replace `x'="fL" if inlist(`x',"fl","femtoliter")                                                                                                                                                    
replace `x'="g" if inlist(`x',"gm")                                                                                                                                                                  
replace `x'="g/d" if inlist(`x',"g/day","g/24hr")                                                                                                                                                    
replace `x'="g/dL" if inlist(`x',"gm/dl","g/dl")                                                                                                                                                     
replace `x'="h" if inlist(`x',"hrs","hr","hour","hours")                                                                                                                                             
replace `x'="mL" if inlist(`x',"ml")                                                                                                                                                                 
replace `x'="mL/d" if inlist(`x',"ml/day","ml/d","ml/alcohol/day")                                                                                                                                   
replace `x'="mL/min/{1.73_m2}" if inlist(`x',"ml/min/{1.73_m2}","ml/minper1.73m2","ml/min/1.73m2","ml/min/1.73m^2")                                                                                  
replace `x'="mL/s" if inlist(`x',"ml/s","ml/sec")                                                                                                                                                    
replace `x'="m[IU]/L" if inlist(`x',"mul","miu/l","mu/l","m[iu]/l")                                                                                                                                  
replace `x'="m[IU]/mL" if inlist(`x',"miu/ml","mu/ml","amiu/ml","m[iu]/ml")                                                                                                                          
replace `x'="meq/L" if inlist(`x',"meq/liter","meq/l")                                                                                                                                               
