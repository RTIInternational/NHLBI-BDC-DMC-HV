replace `x'="[IU]/mL" if inlist(`x',"[iu]/ml","iu/ml")                                                                                                                                               
replace `x'="[cup_us]" if inlist(`x',"cup")                                                                                                                                                          
replace `x'="[ft_us]" if inlist(`x',"ft","feet")                                                                                                                                                     
replace `x'="[hnsf'U]" if inlist(`x',"hu","[hnsf'u]","hounsfieldunits(hu)")                                                                                                                          
