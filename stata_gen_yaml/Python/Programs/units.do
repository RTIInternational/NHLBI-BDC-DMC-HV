

foreach x in `1' {
replace `x' = lower(`x')
replace `x' = subinstr(`x'," ","",.)

replace `x'="%" if inlist(`x',"percent")                    
replace `x'="%{WBCs}" if inlist(`x',"%{wbcs}","percentoftotalleukocytes")
replace `x'="%{normal}" if inlist(`x',"%ofnormal")
replace `x'="1/2cup" if inlist(`x',"1fruit,1/2cupor5dried","1/2cupor2-4sticks","1fruitor1/2cup","1/2cupofcarrotsor2-3oz.ofjuice","1/2fruitor1/2cup","1/2cupvegetables,or1cupofsoup","1earor1/2cup")  
