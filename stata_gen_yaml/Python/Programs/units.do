replace `x'="10*3/uL" if inlist(`x',"x10e3/ul","thou/ul(thousandspermicroliter)","10^3cells/ul","103/mm3","10*3/ul","thousandspermicroliter","x10^3/ul","thousands/ul","10^3/ul")
