replace `x'="none" if inlist(`x',"numberofsiblings","n/a","codes","agatstonunit","numberofkids")                                                                                                     
replace `x'="pg/mL" if inlist(`x',"pg/ml")                                                                                                                                                           
replace `x'="pg/{cell}" if inlist(`x',"pg/cell")                                                                                                                                                     
replace `x'="pmol/L" if inlist(`x',"pmol/l")                                                                                                                                                         
replace `x'="s" if inlist(`x',"seconds")                                                                                                                                                             
replace `x'="uV" if inlist(`x',"uv","microvolts")                                                                                                                                                    
replace `x'="u[IU]/mL" if inlist(`x',"uiu/ml","uu/ml","microu/ml","u[iu]/ml")                                                                                                                        
replace `x'="ug/L" if inlist(`x',"ug/l","mcg/l")                                                                                                                                                     
replace `x'="ug/dL" if inlist(`x',"ug/dl")                                                                                                                                                           
replace `x'="ug/mL" if inlist(`x',"ug/ml")                                                                                                                                                           
replace `x'="um3" if inlist(`x',"microm3","um3(micrometerscubed)")                                                                                                                                   
replace `x'="{#}/d" if inlist(`x',"num/day")                                                                                                                                                         
replace `x'="{#}/mL" if inlist(`x',"num/ml","platelets/ml","{#}/ml")                                                                                                                                 
replace `x'="{#}/uL" if inlist(`x',"{#}/ul","num/ul","number/microl")                                                                                                                                
replace `x'="{beats}/min" if inlist(`x',"beatsperminute","beats/minute","beats","beats/min","beatspermin","bpm")                                                                                     
replace `x'="{breath}/min" if inlist(`x',"breaths/min")                                                                                                                                              
replace `x'="{cells}/uL" if inlist(`x',"kcell/mcl","{cells}/ul","kcell/ul","cells/ul")                                                                                                               
replace `x'="{cigarettes}/d" if inlist(`x',"cigarettesperday","cigarette/day","cigarettes/day")                                                                                                      
replace `x'="{events}/h" if inlist(`x',"events/hr","#/hr","events/hour")                                                                                                                             
replace `x'="{ratio}" if inlist(`x',"ratio")                                                                                                                                                         
replace `x'="{score}" if inlist(`x',"scale","score")                                                                                                                                                 
replace `x'="{servings}" if inlist(`x',"1serving","drinks","servings")                                                                                                                               
replace `x'="{servings}/d" if inlist(`x',"servings/day")                                                                                                                                             
replace `x'="{servings}/wk" if inlist(`x',"servings/week","drinks/week","servingsperweek")     


replace `x'="" if inlist(`x',"none")
}



