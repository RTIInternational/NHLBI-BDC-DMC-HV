replace `x'="mg/L" if inlist(`x',"mg/lfeu","mg/l")                                                                                                                                                   
replace `x'="mg/L{FEU}" if inlist(`x',"mg/lfeu")                                                                                                                                                     
replace `x'="mg/d" if inlist(`x',"mg/24hr","mg/day","mg/24hours")                                                                                                                                    
replace `x'="mg/dL" if inlist(`x',"mgperdl","mg/dl","mgper100ml","mg/100ml")                                                                                                                         
replace `x'="mg/g" if inlist(`x',"mg/gcr")                                                                                                                                                           
replace `x'="mg/mL" if inlist(`x',"mg/ml")                                                                                                                                                           
replace `x'="min" if inlist(`x',"minutes")                                                                                                                                                           
replace `x'="mm/h" if inlist(`x',"mm/hr")                                                                                                                                                            
replace `x'="mm3(10*3/uL)" if inlist(`x',"mm3(10^3/ul)","mm3(1,000,000/microliter)","mm3(1,000,000permicroliter)")                                                                                   
replace `x'="mm[Hg]" if inlist(`x',"tonearest2mm/hg","mm/hg","hgmm","mm[hg]","tonearest2mmhg","mmhg")                                                                                                
replace `x'="mmol/L" if inlist(`x',"mmolperl","mmol/l")                                                                                                                                              
replace `x'="mmol/dL" if inlist(`x',"mmoles/dl","mmol/dl")                                                                                                                                           
replace `x'="mo" if inlist(`x',"months","month")                                                                                                                                                     
replace `x'="ms" if inlist(`x',"msec","milliseconds","millisec")                                                                                                                                     
replace `x'="ng/L" if inlist(`x',"ng/l")                                                                                                                                                             
replace `x'="ng/mL" if inlist(`x',"ng/ml","plasmang/ml")                                                                                                                                             
